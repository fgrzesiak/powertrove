    <EmbeddedResource Include="..\..\src\PowerTrove.Desktop\Resources\Strings.resx" Link="Resources\DesktopStrings.resx" LogicalName="PowerTrove.Desktop.Resources.Strings.resources" />
    <EmbeddedResource Include="..\..\src\PowerTrove.Desktop\Resources\Strings.de.resx" Link="Resources\DesktopStrings.de.resx" LogicalName="PowerTrove.Desktop.Resources.Strings.de.resources" />
  </ItemGroup>
  <ItemGroup>
