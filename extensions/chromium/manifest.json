{
  "manifest_version": 3,
  "name": "PowerTrove Browser Pack",
  "version": "0.1.0",
  "description": "Privacy-first browser actions: Markdown, screenshots, offline pages, PDFs and PowerTrove context.",
  "default_locale": "en",
  "permissions": [
    "activeTab",
    "scripting",
    "contextMenus",
    "downloads",
    "clipboardWrite",
    "nativeMessaging",
    "pageCapture",
    "storage",
    "debugger"
  ],
  "action": {
    "default_title": "PowerTrove Browser Pack",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "commands": {
    "open-selection": {
      "suggested_key": {
        "default": "Alt+Shift+P"
      },
      "description": "Send selected text to PowerTrove"
    }
  },
  "optional_permissions": [
    "tabs"
  ],
  "optional_host_permissions": [
    "<all_urls>",
    "http://*/*",
    "https://*/*"
  ],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
