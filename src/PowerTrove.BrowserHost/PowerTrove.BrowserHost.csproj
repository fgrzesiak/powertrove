<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>PowerTrove.BrowserHost</AssemblyName>
  </PropertyGroup>
  <ItemGroup>
    <!-- Published next to PowerTrove.exe and sharing its self-contained runtime, so the host
         must resolve the same framework set as the app and the pack worker: Microsoft.NETCore.App
         only. A desktop framework reference here would add the Windows Forms runtime to every
         installation. -->
    <ProjectReference Include="../PowerTrove.Core/PowerTrove.Core.csproj" />
  </ItemGroup>
</Project>
