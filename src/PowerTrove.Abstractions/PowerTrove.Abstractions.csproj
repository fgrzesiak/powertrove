<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Public action/provider SDK. Built-in action packs and future extension packs
    reference only this project, never PowerTrove.Core or the desktop host.
    Must stay free of package and project references (enforced by architecture tests).
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>PowerTrove.Abstractions</RootNamespace>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- Compatible SDK releases retain their binding identity across desktop versions. -->
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
    <NoWarn>CS1591;CS1573</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="PowerTrove.Abstractions.Tests" />
  </ItemGroup>

</Project>
