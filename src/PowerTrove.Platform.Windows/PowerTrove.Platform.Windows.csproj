    <Using Include="PowerTrove.Abstractions" />
  </ItemGroup>

  <ItemGroup><ProjectReference Include="..\..\tools\FileKit.Imaging\src\FileKit.Imaging\FileKit.Imaging.csproj" /></ItemGroup>
</Project>
