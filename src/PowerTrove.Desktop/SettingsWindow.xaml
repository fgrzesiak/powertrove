<local:HostedView
    x:Class="PowerTrove.Desktop.SettingsWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:PowerTrove.Desktop"
    xmlns:vm="using:PowerTrove.Application.ViewModels"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid Background="Transparent">
        <Grid.RowDefinitions>
            <RowDefinition Height="48"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Custom title bar (drag region) -->
        <Grid x:Name="AppTitleBar" Padding="16,0,140,0">
            <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                <Image x:Name="TitleBarIcon" Width="16" Height="16" />
                <TextBlock Text="{x:Bind local:UiText.SettingsWindowTitle}" Style="{ThemeResource CaptionTextBlockStyle}" VerticalAlignment="Center" />
            </StackPanel>
        </Grid>

        <ScrollViewer Grid.Row="1" Padding="28,0,28,0">
            <StackPanel MaxWidth="760" Padding="0,4,0,24">
                <TextBlock Text="{x:Bind local:UiText.SettingsHeading}" Style="{ThemeResource TitleTextBlockStyle}" Margin="2,0,0,4" />

                <Border x:Name="ReadOnlyWarning" Visibility="Collapsed" Margin="0,12,0,0">
                    <InfoBar IsOpen="True" IsClosable="False" Severity="Warning"
                             Message="{x:Bind local:UiText.SettingsReadOnlyWarning}" />
                </Border>

                <!-- ContentControl, not StackPanel: only controls have IsEnabled, which children inherit. -->
                <ContentControl x:Name="MainSettingsPanel" IsTabStop="False"
                                HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch">
                    <StackPanel Spacing="4">
                        <!-- General -->
                        <TextBlock Text="{x:Bind local:UiText.SettingsGeneral}" Style="{StaticResource SettingsSectionHeaderStyle}" />
                        <Border Style="{StaticResource SettingsCardStyle}">
                            <Grid ColumnSpacing="16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <FontIcon Glyph="&#xF2B7;" FontSize="18" VerticalAlignment="Center" />
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="{x:Bind local:UiText.SettingsLanguage}" />
                                    <TextBlock Text="{x:Bind local:UiText.SettingsLanguageDescription}" Style="{StaticResource SettingsDescriptionStyle}" />
                                    <TextBlock x:Name="LanguageRestartTextBlock"
                                               Text="{x:Bind local:UiText.SettingsLanguageRestart}"
                                               Style="{StaticResource SettingsDescriptionStyle}"
                                               Foreground="{ThemeResource SystemFillColorCautionBrush}"
                                               Visibility="Collapsed" />
                                </StackPanel>
                                <ComboBox Grid.Column="2" x:Name="LanguageComboBox"
                                          VerticalAlignment="Center" MinWidth="200"
                                          AutomationProperties.Name="{x:Bind local:UiText.SettingsLanguage}"
                                          SelectionChanged="LanguageComboBox_SelectionChanged" />
                            </Grid>
                        </Border>
                        <Border Style="{StaticResource SettingsCardStyle}">
                            <StackPanel Spacing="8">
                                <Grid ColumnSpacing="16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <FontIcon Glyph="&#xE765;" FontSize="18" VerticalAlignment="Center" />
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="{x:Bind local:UiText.SettingsGlobalShortcut}" />
                                        <TextBlock Text="{x:Bind local:UiText.SettingsShortcutDescription}" Style="{StaticResource SettingsDescriptionStyle}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                        <TextBox x:Name="ShortcutTextBox"
                                                 IsReadOnly="True"
                                                 MinWidth="160"
                                                 PreviewKeyDown="ShortcutTextBox_PreviewKeyDown"
                                                 PlaceholderText="{x:Bind local:UiText.SettingsShortcutPlaceholder}"
                                                 AutomationProperties.Name="{x:Bind local:UiText.SettingsGlobalShortcut}" />
                                        <Button Content="{x:Bind local:UiText.SettingsResetShortcut}" Click="ResetShortcut_Click" />
                                    </StackPanel>
                                </Grid>
                                <TextBlock x:Name="ShortcutErrorTextBlock"
                                           Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                                           Style="{ThemeResource CaptionTextBlockStyle}"
                                           TextWrapping="Wrap"
                                           Visibility="Collapsed" />
                            </StackPanel>
                        </Border>

                        <!-- Suggestions -->
                        <TextBlock Text="{x:Bind local:UiText.SettingsSuggestions}" Style="{StaticResource SettingsSectionHeaderStyle}" />
                        <Border Style="{StaticResource SettingsCardStyle}">
                            <StackPanel Spacing="10">
                                <Grid ColumnSpacing="16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <FontIcon Glyph="&#xE81C;" FontSize="18" VerticalAlignment="Center" />
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="{x:Bind local:UiText.SettingsRanking}" />
                                        <TextBlock Text="{x:Bind local:UiText.SettingsSuggestionsPrivacy}" Style="{StaticResource SettingsDescriptionStyle}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                        <Button Content="{x:Bind local:UiText.SettingsClearRecent}" Click="ClearRecentActions_Click" />
                                        <Button Content="{x:Bind local:UiText.SettingsClearSuggestions}" Click="ClearSuggestionsHistory_Click" />
                                    </StackPanel>
                                </Grid>
                                <TextBlock x:Name="ClearRecentStatusTextBlock"
                                           Foreground="{ThemeResource SystemFillColorSuccessBrush}"
                                           Style="{ThemeResource CaptionTextBlockStyle}"
                                           Visibility="Collapsed" />
                                <TextBlock x:Name="ClearSelectionHistoryStatusTextBlock"
                                           Foreground="{ThemeResource SystemFillColorSuccessBrush}"
                                           Style="{ThemeResource CaptionTextBlockStyle}"
                                           Visibility="Collapsed" />
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource SettingsCardStyle}">
                            <StackPanel Spacing="10">
                                <Grid ColumnSpacing="16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <FontIcon Glyph="&#xE718;" FontSize="18" VerticalAlignment="Center" />
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="{x:Bind local:UiText.SettingsPinnedActions}" />
                                        <TextBlock Text="{x:Bind local:UiText.SettingsPinnedDescription}" Style="{StaticResource SettingsDescriptionStyle}" />
                                    </StackPanel>
                                </Grid>
                                <Grid ColumnSpacing="8" Margin="34,0,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="UnpinActionTextBox" PlaceholderText="{x:Bind local:UiText.SettingsUnpinPlaceholder}" />
                                    <Button Grid.Column="1" Content="{x:Bind local:UiText.SettingsUnpinAction}" Click="UnpinAction_Click" />
                                </Grid>
                                <TextBlock x:Name="UnpinActionStatusTextBlock" Margin="34,0,0,0"
                                           Foreground="{ThemeResource SystemFillColorSuccessBrush}"
                                           Style="{ThemeResource CaptionTextBlockStyle}" Visibility="Collapsed" />
                            </StackPanel>
                        </Border>

                        <!-- Files -->
                        <TextBlock Text="{x:Bind local:UiText.SettingsFiles}" Style="{StaticResource SettingsSectionHeaderStyle}" />
                        <Border Style="{StaticResource SettingsCardStyle}">
                            <Grid ColumnSpacing="16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <FontIcon Glyph="&#xE8B7;" FontSize="18" VerticalAlignment="Center" />
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="{x:Bind local:UiText.SettingsOutputDefaults}" />
                                    <TextBlock Text="{x:Bind local:UiText.SettingsOutputDefaultsText}" Style="{StaticResource SettingsDescriptionStyle}" />
                                </StackPanel>
                            </Grid>
                        </Border>

                        <Border Style="{StaticResource SettingsCardStyle}">
                            <StackPanel Spacing="8">
                                <ToggleSwitch x:Name="SeparateProcessToggle" Header="{x:Bind local:UiText.SeparateProcessTitle}"
                                              Toggled="SeparateProcessToggle_Toggled" AutomationProperties.AutomationId="SeparateProcessToggle" />
                                <TextBlock Text="{x:Bind local:UiText.SeparateProcessDescription}" Style="{StaticResource SettingsDescriptionStyle}" TextWrapping="Wrap" />
                                <TextBlock x:Name="SeparateProcessRestartMessage" Text="{x:Bind local:UiText.SeparateProcessRestart}"
                                           Visibility="Collapsed" Style="{StaticResource SettingsDescriptionStyle}" />
                            </StackPanel>
                        </Border>

                        <!-- About -->
                        <TextBlock Text="{x:Bind local:UiText.SettingsAbout}" Style="{StaticResource SettingsSectionHeaderStyle}" />
                        <Border Style="{StaticResource SettingsCardStyle}">
                            <Grid ColumnSpacing="16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Image x:Name="AboutIcon" Width="32" Height="32" VerticalAlignment="Center" />
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="{x:Bind local:UiText.MainWindowTitle}" Style="{ThemeResource BodyStrongTextBlockStyle}" />
                                    <TextBlock Text="{x:Bind local:UiText.SettingsAboutText}" Style="{StaticResource SettingsDescriptionStyle}" />
                                    <Button x:Name="NoticesButton" Content="{x:Bind local:UiText.SettingsNotices}" Click="ShowNotices_Click" Margin="0,8,0,0" />
                                    <TextBlock x:Name="NoticesStatus" TextWrapping="Wrap" Style="{StaticResource SettingsDescriptionStyle}" AutomationProperties.LiveSetting="Polite" />
                                </StackPanel>
                            </Grid>
                        </Border>
                    </StackPanel>
                </ContentControl>

                <Expander x:Name="PackSelectionExpander" Header="{x:Bind local:UiText.PacksHeading}" Expanding="Packs_Expanding" HorizontalAlignment="Stretch"
                          HorizontalContentAlignment="Stretch" Margin="0,12,0,4" AutomationProperties.AutomationId="ActionPacksSection">
                    <StackPanel Spacing="12" Padding="12,0,12,12">
                        <TextBlock Text="{x:Bind local:UiText.PacksPrivacy}" Style="{StaticResource SettingsDescriptionStyle}" TextWrapping="Wrap" />
                        <CheckBox Content="{x:Bind local:UiText.PacksShowMissing}" IsChecked="{x:Bind Packs.ShowNotInstalledActions, Mode=TwoWay}"
                                  IsEnabled="{x:Bind Packs.CanChangeVisibility, Mode=OneWay}" AutomationProperties.AutomationId="ShowMissingPackActions" />
                        <TextBlock Text="{x:Bind local:UiText.PacksLocalDescription}" Style="{StaticResource SettingsDescriptionStyle}" TextWrapping="Wrap" />
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button x:Name="InstallFromFileButton" Content="{x:Bind local:UiText.PacksInstallFromFile}" Click="InstallPackFromFile_Click"
                                    IsEnabled="{x:Bind Packs.CanOperate, Mode=OneWay}" AutomationProperties.AutomationId="InstallPackFromFile" />
                            <Button Content="{x:Bind local:UiText.PacksRefresh}" Click="RefreshPacks_Click" IsEnabled="{x:Bind Packs.CanOperate, Mode=OneWay}" />
                            <Button x:Name="CancelPackInstallButton" Content="{x:Bind local:UiText.CommonCancel}" Click="CancelPackInstall_Click"
                                    IsEnabled="{x:Bind Packs.IsBusy, Mode=OneWay}" />
                        </StackPanel>
                        <ProgressBar IsIndeterminate="True" Visibility="{x:Bind local:Converters.BoolToVisibility(Packs.IsBusy), Mode=OneWay}" />
                        <TextBlock x:Name="PackInstallStatus" Text="{x:Bind Packs.StatusMessage, Mode=OneWay}" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite"
                                   Style="{StaticResource SettingsDescriptionStyle}" />
                        <TextBlock Text="{x:Bind Packs.ProgressText, Mode=OneWay}" Style="{StaticResource SettingsDescriptionStyle}" />
                        <ListView ItemsSource="{x:Bind Packs.Rows, Mode=OneWay}" SelectionMode="None" MaxHeight="420"
                                  AutomationProperties.Name="{x:Bind local:UiText.PacksHeading}">
                            <ListView.ItemContainerStyle>
                                <Style TargetType="ListViewItem">
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                    <Setter Property="Padding" Value="0,10" />
                                </Style>
                            </ListView.ItemContainerStyle>
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="vm:ActionPackRow">
                                    <StackPanel Spacing="6" AutomationProperties.Name="{x:Bind AutomationName}">
                                        <TextBlock Text="{x:Bind Name}" Style="{ThemeResource BodyStrongTextBlockStyle}" TextWrapping="Wrap" />
                                        <TextBlock Text="{x:Bind StateText}" Style="{ThemeResource CaptionTextBlockStyle}" />
                                        <TextBlock Text="{x:Bind Details}" Style="{ThemeResource CaptionTextBlockStyle}" TextWrapping="Wrap" />
                                        <TextBlock Text="{x:Bind CompatibilityText}" TextWrapping="Wrap" Style="{ThemeResource CaptionTextBlockStyle}"
                                                   Visibility="{x:Bind local:Converters.ToVisibility(CompatibilityText)}" />
                                        <TextBlock Text="{x:Bind local:UiText.PacksBundled}" Style="{ThemeResource CaptionTextBlockStyle}"
                                                   Visibility="{x:Bind local:Converters.BoolToVisibility(IsBuiltIn)}" />
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <Button Content="{x:Bind PrimaryText}" Tag="{x:Bind Id}" Click="InstallPack_Click"
                                                    Visibility="{x:Bind local:Converters.BoolToVisibility(HasDownloadAction)}"
                                                    IsEnabled="{x:Bind CanDownload, Mode=OneWay}" AutomationProperties.Name="{x:Bind PrimaryAutomationName}" />
                                            <Button Content="{x:Bind local:UiText.PacksUninstall}" Tag="{x:Bind Id}" Click="UninstallPack_Click"
                                                    Visibility="{x:Bind local:Converters.BoolToVisibility(HasUninstallAction)}"
                                                    IsEnabled="{x:Bind CanUninstall, Mode=OneWay}" AutomationProperties.Name="{x:Bind UninstallAutomationName}" />
                                        </StackPanel>
                                    </StackPanel>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </StackPanel>
                </Expander>

                <TextBlock Text="{x:Bind local:UiText.ExplorerHeading}" Style="{StaticResource SettingsSectionHeaderStyle}" />
                <Border Style="{StaticResource SettingsCardStyle}">
                    <StackPanel Spacing="10">
                        <TextBlock Text="{x:Bind ExplorerDescription}" Style="{StaticResource SettingsDescriptionStyle}" TextWrapping="Wrap" />
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button x:Name="ExplorerAddButton" Content="{x:Bind local:UiText.ExplorerAdd}" Click="ExplorerAdd_Click"
                                    AutomationProperties.AutomationId="ExplorerMenuAdd" />
                            <Button x:Name="ExplorerRemoveButton" Content="{x:Bind local:UiText.ExplorerRemove}" Click="ExplorerRemove_Click"
                                    AutomationProperties.AutomationId="ExplorerMenuRemove" />
                        </StackPanel>
                        <TextBlock x:Name="ExplorerMenuStatus" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite"
                                   Style="{StaticResource SettingsDescriptionStyle}" />
                    </StackPanel>
                </Border>

                <!-- Release checks and explicit installer download. -->
                <TextBlock Text="{x:Bind local:UiText.UpdatesHeading}" Style="{StaticResource SettingsSectionHeaderStyle}" />
                <Border x:Name="StoreUpdatesCard" Style="{StaticResource SettingsCardStyle}" Visibility="Collapsed">
                    <StackPanel Spacing="10">
                        <TextBlock Text="{x:Bind Updates.InstalledVersionText}" Style="{ThemeResource BodyStrongTextBlockStyle}" />
                        <TextBlock Text="{x:Bind local:UiText.StoreUpdatesDescription}" Style="{StaticResource SettingsDescriptionStyle}" TextWrapping="Wrap" />
                        <Button Content="{x:Bind local:UiText.StoreUpdatesOpen}" Click="OpenStoreUpdates_Click" />
                        <TextBlock x:Name="StoreUpdatesStatus" Style="{StaticResource SettingsDescriptionStyle}" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />
                    </StackPanel>
                </Border>
                <Border x:Name="GitHubUpdatesCard" Style="{StaticResource SettingsCardStyle}">
                    <StackPanel Spacing="10">
                        <ToggleSwitch x:Name="StartupUpdatesToggle" Header="{x:Bind local:UiText.UpdatesStartup}"
                                      Toggled="StartupUpdatesToggle_Toggled" />
                        <TextBlock Text="{x:Bind Updates.InstalledVersionText}" Style="{ThemeResource BodyStrongTextBlockStyle}" />
                        <TextBlock Text="{x:Bind local:UiText.UpdatesPrivacy}" Style="{StaticResource SettingsDescriptionStyle}" TextWrapping="Wrap" />
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button Content="{x:Bind local:UiText.UpdatesCheck}" Click="CheckForUpdates_Click"
                                    IsEnabled="{x:Bind Updates.CanCheck, Mode=OneWay}"
                                    AutomationProperties.Name="{x:Bind local:UiText.UpdatesCheck}" />
                            <Button Content="{x:Bind local:UiText.UpdatesInstall}" Click="InstallUpdate_Click"
                                    IsEnabled="{x:Bind Updates.CanInstall, Mode=OneWay}" AutomationProperties.AutomationId="SettingsInstallUpdate" />
                            <Button Content="{x:Bind local:UiText.UpdatesCancel}" Click="CancelUpdate_Click"
                                    IsEnabled="{x:Bind Updates.CanCancelInstall, Mode=OneWay}" />
                            <Button Content="{x:Bind local:UiText.UpdatesOpenPage}" Click="OpenReleasePage_Click"
                                    IsEnabled="{x:Bind Updates.CanOpen, Mode=OneWay}"
                                    AutomationProperties.Name="{x:Bind local:UiText.UpdatesOpenPage}" />
                        </StackPanel>
                        <TextBlock Text="{x:Bind Updates.StatusMessage, Mode=OneWay}" TextWrapping="Wrap"
                                   AutomationProperties.LiveSetting="Polite" Style="{StaticResource SettingsDescriptionStyle}" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="2"
                BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                BorderThickness="0,1,0,0"
                Padding="28,12,28,14">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
                <Button Content="{x:Bind local:UiText.SettingsResetDefaults}" Click="ResetToDefaults_Click" />
                <Button Content="{x:Bind local:UiText.CommonClose}" Click="CloseButton_Click" Style="{ThemeResource AccentButtonStyle}" />
            </StackPanel>
        </Border>
    </Grid>
</local:HostedView>
