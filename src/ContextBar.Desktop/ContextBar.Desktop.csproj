<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <RootNamespace>ContextBar.Desktop</RootNamespace>
    <AssemblyName>PowerTrove</AssemblyName>
    <Product>PowerTrove</Product>
    <Title>PowerTrove</Title>
    <Platforms>x86;x64;ARM64</Platforms>
    <RuntimeIdentifiers>win-x86;win-x64;win-arm64</RuntimeIdentifiers>
    <UseWinUI>true</UseWinUI>
    <!-- Launch as an unpackaged WinUI desktop EXE; enable Windows App Runtime bootstrapper. -->
    <WindowsPackageType>None</WindowsPackageType>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- Preserve our explicit single-instance entry point; suppress generated WinUI Program.Main. -->
    <DefineConstants>$(DefineConstants);DISABLE_XAML_GENERATED_MAIN</DefineConstants>
    <ContextBarProfile Condition="'$(ContextBarProfile)' == ''">Full</ContextBarProfile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="2.5.1" />
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="BuiltInActionPacks.Full.cs" Condition="'$(ContextBarProfile)' == 'Base'" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\ContextBar.Application\ContextBar.Application.csproj" />
    <ProjectReference Include="..\ContextBar.Core\ContextBar.Core.csproj" />
    <ProjectReference Include="..\ContextBar.Platform.Windows\ContextBar.Platform.Windows.csproj" />
    <ProjectReference Include="..\ContextBar.Infrastructure\ContextBar.Infrastructure.csproj" />
    <ProjectReference Include="..\..\packs\ContextBar.Pack.Files\composition\ContextBar.Pack.Files.Composition\ContextBar.Pack.Files.Composition.csproj" />
    <ProjectReference Include="..\..\packs\ContextBar.Pack.Images\composition\ContextBar.Pack.Images.Composition\ContextBar.Pack.Images.Composition.csproj" Condition="'$(ContextBarProfile)' == 'Full'" />
    <ProjectReference Include="..\..\packs\ContextBar.Pack.Media\composition\ContextBar.Pack.Media.Composition\ContextBar.Pack.Media.Composition.csproj" Condition="'$(ContextBarProfile)' == 'Full'" />
    <ProjectReference Include="..\..\packs\ContextBar.Pack.Pdf\composition\ContextBar.Pack.Pdf.Composition\ContextBar.Pack.Pdf.Composition.csproj" />
    <ProjectReference Include="..\..\packs\ContextBar.Pack.Office\composition\ContextBar.Pack.Office.Composition\ContextBar.Pack.Office.Composition.csproj" Condition="'$(ContextBarProfile)' == 'Full'" />
    <ProjectReference Include="..\..\packs\ContextBar.Pack.Tables\composition\ContextBar.Pack.Tables.Composition\ContextBar.Pack.Tables.Composition.csproj" Condition="'$(ContextBarProfile)' == 'Full'" />
    <ProjectReference Include="..\..\packs\ContextBar.Pack.Data\composition\ContextBar.Pack.Data.Composition\ContextBar.Pack.Data.Composition.csproj" Condition="'$(ContextBarProfile)' == 'Full'" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="aliases.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="catalog.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>
  <ItemGroup>
    <Using Include="ContextBar.Abstractions" />
  </ItemGroup>

</Project>
