<Project>
  <!--
    Standalone build settings for FileKit.Detection. This folder must build without
    anything outside of it, so it can be moved to its own repository unchanged
    (see docs/architecture/action-packs-and-tools.md).
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <VersionPrefix>0.1.0</VersionPrefix>
    <Authors>ContextBar contributors</Authors>
    <Product>FileKit</Product>
    <Description>Dependency-free file format detection from content signatures (magic bytes).</Description>
    <PackageTags>file-format;magic-bytes;detection</PackageTags>
    <!-- No package license is declared until the owner selects one (docs/licensing). -->
  </PropertyGroup>

  <PropertyGroup Condition="!$(MSBuildProjectName.EndsWith('.Tests'))">
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
    <IsPackable>true</IsPackable>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup Condition="!$(MSBuildProjectName.EndsWith('.Tests')) And '$(OutputType)' != 'Exe'">
    <None Include="$(MSBuildThisFileDirectory)README.md" Pack="true" PackagePath="\" Visible="false" />
  </ItemGroup>
</Project>
