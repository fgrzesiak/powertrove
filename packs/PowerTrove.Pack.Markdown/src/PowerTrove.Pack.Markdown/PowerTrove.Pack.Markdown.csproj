<Project Sdk="Microsoft.NET.Sdk">

  <!-- Action pack: Markdown viewer/editor previews and Markdown/HTML/PDF conversions. References only the SDK and tools. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>PowerTrove.Pack.Markdown</RootNamespace>
    <VersionPrefix>0.1.0</VersionPrefix>
  </PropertyGroup>

  <ItemGroup>
    <Using Include="PowerTrove.Abstractions" />
    <Using Include="PowerTrove.Abstractions.Files" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\..\src\PowerTrove.Abstractions\PowerTrove.Abstractions.csproj" />
    <ProjectReference Include="..\..\..\..\tools\FileKit.Html\src\FileKit.Html\FileKit.Html.csproj" />
    <ProjectReference Include="..\..\..\..\tools\FileKit.Text\src\FileKit.Text\FileKit.Text.csproj" />
    <ProjectReference Include="..\..\..\..\tools\FileKit.Detection\src\FileKit.Detection\FileKit.Detection.csproj" />
    <ProjectReference Include="..\..\..\..\tools\FileKit.Tabular\src\FileKit.Tabular\FileKit.Tabular.csproj" />
    <ProjectReference Include="..\..\..\..\tools\FileKit.Xlsx\src\FileKit.Xlsx\FileKit.Xlsx.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="PowerTrove.Pack.Markdown.Composition" />
    <InternalsVisibleTo Include="PowerTrove.Pack.Markdown.Tests" />
  </ItemGroup>
  <ItemGroup><Compile Include="../../../PackReleaseVersion.cs" Link="PackReleaseVersion.cs" /></ItemGroup>
  <Import Project="$(PowerTrovePackVersionsFile)" Condition="'$(PowerTrovePackVersionsFile)' != ''" />
</Project>
