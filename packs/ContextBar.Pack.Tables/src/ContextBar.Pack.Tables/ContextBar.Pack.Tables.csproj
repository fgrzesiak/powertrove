<Project Sdk="Microsoft.NET.Sdk">

  <!-- Action pack: exports of table selections (CSV, JSON, Markdown, SQL). References only the SDK. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>ContextBar.Pack.Tables</RootNamespace>
    <VersionPrefix>0.1.0</VersionPrefix>
  </PropertyGroup>

  <ItemGroup>
    <Using Include="ContextBar.Abstractions" />
    <Using Include="ContextBar.Abstractions.Files" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\..\src\ContextBar.Abstractions\ContextBar.Abstractions.csproj" />
    <ProjectReference Include="..\..\..\..\tools\FileKit.Tabular\src\FileKit.Tabular\FileKit.Tabular.csproj" />
    <ProjectReference Include="..\..\..\..\tools\FileKit.Xlsx\src\FileKit.Xlsx\FileKit.Xlsx.csproj" />
  </ItemGroup>

  <ItemGroup><InternalsVisibleTo Include="ContextBar.Pack.Tables.Composition" /></ItemGroup>
</Project>
