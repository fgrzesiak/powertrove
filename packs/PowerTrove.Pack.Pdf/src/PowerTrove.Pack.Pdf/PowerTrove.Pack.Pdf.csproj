<Project Sdk="Microsoft.NET.Sdk">

  <!-- Action pack: PDF page tools. References only the SDK and FileKit tools. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>PowerTrove.Pack.Pdf</RootNamespace>
    <VersionPrefix>0.1.0</VersionPrefix>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\..\tools\FileKit.Html\src\FileKit.Html\FileKit.Html.csproj" />
    <Using Include="PowerTrove.Abstractions" />
    <Using Include="PowerTrove.Abstractions.Files" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="PowerTrove.Pack.Pdf.Tests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\..\src\PowerTrove.Abstractions\PowerTrove.Abstractions.csproj" />
    <ProjectReference Include="..\..\..\..\tools\FileKit.Pdf\src\FileKit.Pdf\FileKit.Pdf.csproj" />
  </ItemGroup>

  <ItemGroup><InternalsVisibleTo Include="PowerTrove.Pack.Pdf.Composition" /></ItemGroup>
  <ItemGroup><ProjectReference Include="../../../../tools/FileKit.Tabular/src/FileKit.Tabular/FileKit.Tabular.csproj" /><ProjectReference Include="../../../../tools/FileKit.Xlsx/src/FileKit.Xlsx/FileKit.Xlsx.csproj" /></ItemGroup>
  <ItemGroup><Compile Include="../../../PackReleaseVersion.cs" Link="PackReleaseVersion.cs" /></ItemGroup>
  <Import Project="$(PowerTrovePackVersionsFile)" Condition="'$(PowerTrovePackVersionsFile)' != ''" />
</Project>
