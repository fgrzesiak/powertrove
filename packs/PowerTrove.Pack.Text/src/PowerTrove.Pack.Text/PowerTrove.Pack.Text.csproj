<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>PowerTrove.Pack.Text</RootNamespace>
    <VersionPrefix>0.1.0</VersionPrefix>
  </PropertyGroup>
  <ItemGroup>
    <Using Include="PowerTrove.Abstractions" />
    <ProjectReference Include="../../../../src/PowerTrove.Abstractions/PowerTrove.Abstractions.csproj" />
    <InternalsVisibleTo Include="PowerTrove.Pack.Text.Tests" />
    <InternalsVisibleTo Include="PowerTrove.Pack.Text.Composition" />
  </ItemGroup>
  <ItemGroup><Compile Include="../../../PackReleaseVersion.cs" Link="PackReleaseVersion.cs" /></ItemGroup>
  <Import Project="$(PowerTrovePackVersionsFile)" Condition="'$(PowerTrovePackVersionsFile)' != ''" />
</Project>
