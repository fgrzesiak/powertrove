<Project Sdk="Microsoft.NET.Sdk">

  <!-- Action pack: audio and video conversion. References only the SDK and FileKit tools. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>ContextBar.Pack.Media</RootNamespace>
    <VersionPrefix>0.1.0</VersionPrefix>
  </PropertyGroup>

  <ItemGroup>
    <Using Include="ContextBar.Abstractions" />
    <Using Include="ContextBar.Abstractions.Files" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\..\src\ContextBar.Abstractions\ContextBar.Abstractions.csproj" />
  </ItemGroup>

  <ItemGroup><InternalsVisibleTo Include="ContextBar.Pack.Media.Composition" /></ItemGroup>
</Project>
